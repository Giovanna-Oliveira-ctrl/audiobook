{
  "id": "./",
  "name": "AUDIOBOOK — Audiolivros offline",
  "short_name": "Audiobook",
  "description": "Sua biblioteca pessoal de audiolivros: importe, organize e ouça offline, com reprodução em segundo plano e controles na tela de bloqueio.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./?origem=pwa#/inicio",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#11100e",
  "theme_color": "#11100e",
  "categories": ["books", "entertainment", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Continuar ouvindo",
      "short_name": "Continuar",
      "url": "./?origem=atalho#/player",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Minha biblioteca",
      "short_name": "Biblioteca",
      "url": "./?origem=atalho#/biblioteca",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Importar audiolivro",
      "short_name": "Importar",
      "url": "./?origem=atalho#/importar",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", ".mp3", ".m4a", ".m4b", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac", ".webm"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?origem=arquivo",
      "accept": {
        "audio/*": [".mp3", ".m4a", ".m4b", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac", ".webm"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
